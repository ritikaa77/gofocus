# PostgreSQL connection string (Neon, Supabase, Render Postgres, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/gofocus
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Day boundaries (streaks, "today's picks") are computed in this timezone
APP_TZ=Asia/Kolkata
# Local demo only: adds a 6-second session length so you can see a full session quickly
ALLOW_SHORT_SESSIONS=false
PORT=3000
